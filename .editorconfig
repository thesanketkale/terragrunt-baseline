root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tf,tfvars,hcl}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.md]
insert_final_newline = true
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
indent_size = 4
indent_style = space

[*.sh]
end_of_line = lf
indent_size = 2
indent_style = space
